# ==============================================================================
# CodeStride Backend - Environment Configuration Template
# Copy this file to .env for local testing (never commit .env to version control)
# ==============================================================================

# Server Configuration (Optional for local dev, defaults to 8080; dynamically set by Render)
PORT=8080

# CORS Configuration (Comma-separated allowed origins for frontend; defaults to localhost if unset)
# Example for production: https://codestride.vercel.app,https://codestride-preview.vercel.app
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# MongoDB Connection Configuration
# Format: mongodb+srv://<username>:<password>@<cluster-url>/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/codestride?retryWrites=true&w=majority
MONGODB_DATABASE=codestride

# JWT Configuration (Must be at least 256 bits / 32 bytes for HMAC-SHA256)
APP_JWT_SECRET=replace_with_a_long_random_secret_at_least_32_bytes
